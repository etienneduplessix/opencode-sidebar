{
  "manifest_version": 3,
  "name": "OpenCode Sidebar",
  "version": "0.2.0",
  "description": "Select text on any page, chat with OpenCode, read the page, act on it, and apply fixes in place.",
  "permissions": ["activeTab", "tabs", "sidePanel", "scripting", "contextMenus", "storage"],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:53213/*",
    "http://localhost:53213/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["selection-capture.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "OpenCode Sidebar"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {}
}
