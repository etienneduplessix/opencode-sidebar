{
  "manifest_version": 3,
  "name": "OpenCode Sidebar",
  "version": "0.3.0",
  "description": "Select text on any page, chat with OpenCode, read the page, act on it, and apply fixes in place.",
  "permissions": ["activeTab", "tabs", "sidePanel", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["selection-capture.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "OpenCode Sidebar",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
